# Copy this file to .env and fill in the key. Never commit .env.
# Create a key at https://platform.openai.com/api-keys

OPENAI_API_KEY=

# Model id stays here so a rename does not require a code change.
# gpt-4o-mini supports tool calling and structured outputs.
OPENAI_MODEL=gpt-4o-mini

# Tracing stays off until you set LANGSMITH_TRACING to true and add a key.
# The model call copies these into the LANGCHAIN_* names LangChain reads.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=studypilot
